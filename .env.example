# ============================================================
#  Spherex-Streak-Detection-Engine — .env.example
#  انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
#  cp .env.example .env
# ============================================================

# ---------------------------
# مسارات البيانات
# ---------------------------
DATA_DIR=data/raw
PROCESSED_DIR=data/processed
MASKS_DIR=data/masks

# ---------------------------
# مجموعة بيانات SPARKLES (Zenodo)
# ---------------------------
ZENODO_RECORD_ID=10935280

# ---------------------------
# إعدادات النموذج
# ---------------------------
MODEL_CHECKPOINT=checkpoints/deepstreaks_best.pt
DEVICE=cuda                  # cuda | cpu | mps

# ---------------------------
# إعدادات التدريب
# ---------------------------
BATCH_SIZE=16
NUM_EPOCHS=50
LEARNING_RATE=1e-4
FOCAL_GAMMA=2.0
FOCAL_ALPHA=0.25

# ---------------------------
# إعدادات PQM
# ---------------------------
PQM_THRESHOLD=0.5

# ---------------------------
# Streamlit UI
# ---------------------------
STREAMLIT_PORT=8501
